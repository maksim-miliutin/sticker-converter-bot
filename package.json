{
  "name": "sticker-converter-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram bot that turns images into stickers and converts image formats",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/main.ts | pino-pretty",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "pino-pretty": "^13.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "grammy": "^1.46.0",
    "pino": "^10.4.0",
    "socks-proxy-agent": "^10.1.0"
  }
}
