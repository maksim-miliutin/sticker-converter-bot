# Token of a test bot from @BotFather. Never commit the real .env file.
BOT_TOKEN=

# fatal, error, warn, info, debug, trace or silent. Defaults to info.
LOG_LEVEL=info

# Optional SOCKS proxy for every request to Telegram; leave empty for a direct
# connection. For Cloudflare WARP in Local Proxy mode: socks5h://127.0.0.1:40000
# (socks5h lets the proxy resolve api.telegram.org, so local DNS is never asked).
TELEGRAM_PROXY_URL=

# How long Telegram holds each long-polling request open, 1-50 seconds; defaults
# to 30. Cloudflare WARP in Local Proxy mode drops any request longer than
# 10 seconds, so set 5 when TELEGRAM_PROXY_URL points at WARP.
POLLING_TIMEOUT_SECONDS=

# Largest image the bot downloads, in megabytes, 1-20; defaults to 20, the most
# the cloud Bot API serves through getFile.
MAX_FILE_MB=

# Largest image the bot decodes, in megapixels, 1-100; defaults to 50. Checked
# from the file header before decoding, so a small file claiming huge
# dimensions is refused without using the memory it asks for.
MAX_INPUT_MEGAPIXELS=

# SQLite file with the list of sticker sets the bot created; defaults to
# data/bot.sqlite. The folder is created on start and is not committed.
DATABASE_PATH=
