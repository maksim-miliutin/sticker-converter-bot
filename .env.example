# Token of a test bot from @BotFather. Never commit the real .env file.
BOT_TOKEN=

# fatal, error, warn, info, debug, trace or silent. Defaults to info.
LOG_LEVEL=info

# Optional SOCKS proxy for every request to Telegram; leave empty for a direct
# connection. For Cloudflare WARP in Local Proxy mode: socks5h://127.0.0.1:40000
# (socks5h lets the proxy resolve api.telegram.org, so local DNS is never asked).
TELEGRAM_PROXY_URL=
